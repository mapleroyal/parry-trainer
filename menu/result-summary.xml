<root>
  <styles>
    <include src="s2r://panorama/styles/citadel_base_styles.vcss" />
    <include src="s2r://panorama/styles/popups/popups_shared.vcss" />
    <include src="file://{resources}/styles/parry_trainer_score.css" />
  </styles>
  <Panel class="PopupPanel Hidden PTCardSurface PTRunRecap" popupbackground="dim" oncancel="UIPopupButtonClicked()">
    <Panel id="ParryTrainerSummaryBody" />
    <Panel class="PTRecapFooter">
      <Panel class="PTRecapHelp">
        <Label class="PTRecapHint" text="Press" />
        <CitadelBinding class="PTRecapHint" action="Scoreboard" show_single_bind="true" compact="true" />
        <Label class="PTRecapHint" text="and open Score to see these results again." />
      </Panel>
      <Button id="ParryTrainerRecapClose" class="PTRecapClose" onactivate="UIPopupButtonClicked()">
        <Label text="#Close" />
      </Button>
    </Panel>
  </Panel>
</root>
