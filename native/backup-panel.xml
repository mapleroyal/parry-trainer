<Panel id="ParryTrainerLibraryBackup" class="PTProfileSection">
  <Label text="Whole-trainer backup" class="PTHeading" />
  <Label text="Export your settings, saved drills and hero builds here. Copy the text to a file, or paste a backup to restore it." class="PTProfileMinor" />
  <TextEntry id="ParryTrainerBackupText" class="PTLimitInput PTLibraryName PTBackupText" maxchars="262144" acceptsfocus="true" />
  <Panel class="PTProfileBar">
    <Button id="ParryTrainerProfileExport" class="PTSubAction" onactivate="ParryTrainerNativeBackupRequest('export')" acceptsfocus="true"><Label text="Export backup" /></Button>
    <Button id="ParryTrainerProfileImport" class="PTSubAction" onactivate="ParryTrainerNativeBackupRequest('import')" acceptsfocus="true"><Label text="Import backup" /></Button>
  </Panel>
  <Label id="ParryTrainerBackupFeedback" text="" class="PTProfileMinor" />
</Panel>
